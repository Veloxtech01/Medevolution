{
  "redirects": [
    {
      "source": "/product-category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
